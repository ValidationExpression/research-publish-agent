{
  "name": "@wechatsync/local-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wechatsync 本地发稿服务（实现 Node Runtime，复用 core 适配器）",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./publish-runtime": "./dist/publish-runtime.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "start": "node dist/index.js",
    "smoke": "node dist/smoke.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wechatsync/core": "workspace:*",
    "@types/marked": "^6.0.0",
    "hast-util-to-string": "^3.0.0",
    "js-md5": "^0.8.3",
    "jszip": "^3.10.1",
    "juice": "^11.1.0",
    "linkedom": "^0.18.12",
    "markdown-draft-js": "^2.4.0",
    "marked": "^17.0.1",
    "rehype-parse": "^9.0.0",
    "rehype-remark": "^10.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remarkable": "^2.0.1",
    "turndown": "^7.2.2",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "ws": "^8.16.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.10",
    "tsup": "^8.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.3.0"
  }
}
