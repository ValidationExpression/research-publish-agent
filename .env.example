# =============================================================================
# Research Publish Agent 环境配置
# 仅使用仓库根目录这一份 .env，不要在 packages/research-agent 下再建副本
# 创建方式：cp .env.example .env
# =============================================================================

# =============================================================================
# 发稿运行时（local-server / cookie-provider 插件）
# =============================================================================

# 本地发稿服务鉴权 Token；Chrome 插件弹窗中需填写相同值
WECHATSYNC_TOKEN=wechatsync-local

# 发稿 HTTP 端口（REST API，默认 8787）
WECHATSYNC_HTTP_PORT=8787

# Cookie WebSocket 端口（Chrome 插件连接，默认 9527）
WECHATSYNC_WS_PORT=9527

# =============================================================================
# 研究服务（Python sidecar）
# =============================================================================

# 研究服务 HTTP 端口（FastAPI + SSE，默认 8765）
RESEARCH_HTTP_PORT=8765

# 研究服务鉴权 Token（桌面端调用时使用）
RESEARCH_TOKEN=research-local

# LLM API Key（必填；默认对接 DeepSeek，也可换其他 OpenAI 兼容服务）
OPENAI_API_KEY=

# LLM 接口地址（OpenAI 兼容 API Base URL）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# LLM 模型名称
OPENAI_MODEL=deepseek-chat

# Tavily 搜索 API Key（必填；Agent 联网检索时使用）
TAVILY_API_KEY=

# 访问 api.tavily.com 出现 SSL UNEXPECTED_EOF 时，指向本地代理（Clash / V2Ray 常见端口 7890）
# TAVILY_HTTPS_PROXY=http://127.0.0.1:7890

# 整次研究超时（秒），0 表示不限制
# RESEARCH_JOB_TIMEOUT=0
# 单次模型调用超时（秒）
# RESEARCH_LLM_TIMEOUT=600
